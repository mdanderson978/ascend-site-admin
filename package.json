{
  "name": "site-admin",
  "version": "2.17.0",
  "description": "Ascend Web Design's local CMS admin engine for split-repo Astro sites. Consumed by content repos as a git dependency pinned to a version tag.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./verify": "./verify-site.mjs",
    "./elements": "./elements/index.mjs",
    "./elements/css": "./elements/css.mjs"
  },
  "files": [
    "index.mjs",
    "admin.html",
    "rich-html.mjs",
    "redirects.mjs",
    "linkFixer.mjs",
    "menus.mjs",
    "verify-site.mjs",
    "elements",
    "dist/admin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdanderson978/ascend-site-admin.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run typecheck && npm run build:ui",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "playground": "node playground/server.mjs",
    "typecheck": "tsc -p ui/tsconfig.json",
    "test": "node --test test/engine.test.mjs test/shortcode-registry.test.mjs test/save-uploads-prune.test.mjs test/youtube-thumbnail.test.mjs test/rich-html.test.mjs test/elements/html-sanitize.test.mjs test/elements/pipeline.test.mjs test/elements/render.test.mjs test/elements/css-package.test.mjs test/elements/playground.test.mjs && npm run test:ui",
    "test:ui": "vitest run --config ui/vite.config.ts",
    "test:e2e": "playwright test --config playwright.config.mjs",
    "prepack": "npm run build",
    "verify": "npm run build && npm test && npm audit --omit=dev && node --check index.mjs && node --check verify-site.mjs"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "gray-matter": "^4.0.3",
    "parse5": "^8.0.1",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "html-validate": "^9.7.1",
    "js-yaml": "^3.15.2",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "js-yaml": {
      "argparse": "^2.0.1"
    }
  }
}
